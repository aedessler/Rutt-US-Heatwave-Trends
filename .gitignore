# Scripts only. Every byte of data, cache and figure output in this tree is
# regenerated by `python figures/prepare_data.py` and the figure scripts, so
# none of it is committed.

# ── derived inputs, caches and local staging ────────────────────────────────
_data/
_stage/
_cache_*/
cache_*/

# ── figure output ───────────────────────────────────────────────────────────
PAPER_FIGURES_FINAL/

# ── data formats, wherever they land ────────────────────────────────────────
*.nc
*.nc4
*.hdf
*.hdf5
*.h5
*.grib
*.grb
*.grb2
*.parquet
*.feather
*.npz
*.npy
*.pkl
*.pickle
*.csv
*.tsv
*.txt
!requirements.txt
*.gz
*.bz2
*.xz
*.zip
*.tar
*.7z

